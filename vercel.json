{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "frontend/dist",
  "functions": {
    "backend/src/**/*.js": {
      "includeFiles": "frontend/dist/index.html"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/backend/src/:path*.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "cleanUrls": true
}